# ==========================================
# PillCare - Git Ignore
# ==========================================

# ------------------------------
# Dependencies
# ------------------------------
node_modules/
.pnp/
.pnp.js

# ------------------------------
# Build output
# ------------------------------
dist/
dist-ssr/
build/
coverage/

# ------------------------------
# Environment variables
# ------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Keep an example environment file
!.env.example

# ------------------------------
# Logs
# ------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------
# Editor / IDE
# ------------------------------
.vscode/*
!.vscode/extensions.json

.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ------------------------------
# Operating system files
# ------------------------------
.DS_Store
Thumbs.db

# ------------------------------
# Temporary files
# ------------------------------
*.tmp
*.temp
*.bak
*.swp
*.swo

# ------------------------------
# Vite
# ------------------------------
.vite/

# ------------------------------
# Testing
# ------------------------------
.nyc_output/